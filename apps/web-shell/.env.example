# API Configuration
# Base URL for API requests. Default: /api
VITE_API_URL=/api

# Mock Mode
# Set to 'true' for development without backend (MSW intercepts all API requests)
# Set to 'false' or omit for real backend connection
VITE_API_MOCK=true

# Remotes URLs
REMOTE_WEB_ACCOUNTS_URL=http://localhost:3001