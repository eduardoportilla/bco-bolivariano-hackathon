# Services and State

## Core Package Services

Services live in `@repo/core` and use the adapter pattern:

```typescript
// @repo/core/domains/accounts/service.ts
export function createAccountsService(http: HttpClient) {
  return {
    getAll: () => http.get<Account[]>(API_ENDPOINTS.accounts.list),
    getById: (id: string) => http.get<Account>(API_ENDPOINTS.accounts.detail(id)),
  };
}
```

## Wiring Services in Apps

```typescript
// apps/web-shell/src/services/index.ts
import { httpClient } from '../adapters/http.web';
import { createAccountsService } from '@repo/core/domains/accounts';

export const accountsService = createAccountsService(httpClient);
```

## Query Keys (from Core)

```typescript
// Import keys from @repo/core
import { accountKeys } from '@repo/core/domains/accounts';

// Use in hooks
useQuery({
  queryKey: accountKeys.detail(id),
  queryFn: () => accountsService.getById(id),
});
```

## Zustand

```typescript
// Use selectors to avoid re-renders
const user = useAuthStore((s) => s.user);

// Avoid destructuring entire store
const { user } = useAuthStore(); // BAD
```

## Forms (Schemas from Core)

```typescript
// Import schemas from @repo/core
import { transferSchema, type TransferFormData } from '@repo/core/domains/transfers';

const { register, handleSubmit } = useForm<TransferFormData>({
  resolver: zodResolver(transferSchema),
});
```

