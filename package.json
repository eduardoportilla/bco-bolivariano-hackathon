{
  "name": "banco-bolivariano-hackathon",
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "19.2.3",
      "react-dom": "19.2.3"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-25128"
      ]
    },
    "ignoredBuiltDependencies": [
      "msw"
    ]
  },
  "scripts": {
    "dev": "turbo dev",
    "preview:web": "turbo preview:mfe --filter=web-*",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "node scripts/reset.js --no-install",
    "reset": "node scripts/reset.js",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fb-watchman": "^2.0.2"
  }
}